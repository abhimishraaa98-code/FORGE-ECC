{
  "name": "forge-engineering-workbench",
  "version": "0.21.0",
  "private": false,
  "description": "An open-source AI engineering workbench for project understanding, planning, and verified workflows.",
  "type": "module",
  "bin": {
    "forge": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "developer-tools",
    "engineering",
    "code-quality",
    "workflows"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "typescript": "^5.8.3"
  }
}
